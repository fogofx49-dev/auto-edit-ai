
package com.fogofx.autoeditai

import androidx.media3.common.OverlaySettings
import androidx.media3.common.VideoCompositorSettings
import androidx.media3.common.util.Size
import androidx.media3.common.util.UnstableApi
import androidx.media3.effect.StaticOverlaySettings

data class CrossfadeClipSpan(
    val inputId: Int,
    val startMs: Long,
    val endMs: Long,
    val fadeInDurationMs: Long
)

@UnstableApi
class CrossfadeVideoCompositorSettings(
    private val clips: List<CrossfadeClipSpan>
) : VideoCompositorSettings {

    override fun getOutputSize(
        inputSizes: List<Size>
    ): Size {
        return inputSizes.first()
    }

    override fun getOverlaySettings(
        inputId: Int,
        presentationTimeUs: Long
    ): OverlaySettings {

        val timeMs = presentationTimeUs / 1000L

        val clip = clips.firstOrNull {
            it.inputId == inputId
        }

        val alpha = if (
            clip == null ||
            timeMs < clip.startMs ||
            timeMs >= clip.endMs
        ) {
            0f
        } else if (clip.fadeInDurationMs <= 0L) {
            1f
        } else {
            (
                (timeMs - clip.startMs).toFloat() /
                clip.fadeInDurationMs.toFloat()
            ).coerceIn(0f, 1f)
        }

        return StaticOverlaySettings.Builder()
            .setAlphaScale(alpha)
            .build()
    }
}
